    watchedPanel: {fileID: 1480193591}
    enforceWatchedPanelState: 1
    watchedPanelShouldBeVisible: 1
  - stepId: Monster_Select_3
    body: A war can hardly be fought with such pitiful numbers, but that's where
      I can be of assistance. (Press [F] to Continue)
    pauseGameplay: 0
    allowSkip: 0
    autoAdvanceOnComplete: 1
    allowSoftDropDuringStep: 0
