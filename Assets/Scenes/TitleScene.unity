    enforceWatchedPanelState: 1
    watchedPanelShouldBeVisible: 1
  - stepId: Monster_Select_3.5
    body: I can make clones of your squadron to be sent into battle. This will allow
      multiple copies to be made to fill out your ranks. However, this will come
      with some limitations. (Press [F] to Continue)
    pauseGameplay: 0
    allowSkip: 0
    autoAdvanceOnComplete: 1
