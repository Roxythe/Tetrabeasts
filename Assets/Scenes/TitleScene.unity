--- !u!114 &902345670
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 714147406}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a1b2c3d4e5f6478899aabbccddeeff01, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TitleTipTextRotator
  tipText: {fileID: 714147408}
  backgroundRect: {fileID: 0}
  backgroundPadding: {x: 24, y: 18}
  minimumBackgroundHeight: 44
  maximumBackgroundHeight: 0
  avoidImmediateRepeat: 1
  tips:
  - 'Tip: Special blocks activate as soon as they are placed.'
  - 'Tip: Rerolls can be saved and used on future reward screens during the same
    run.'
  - 'Tip: Temporary monster copies earn EXP during a run, and some of it becomes
    permanent after the run ends giving you stronger units to start a run with.'
  - 'Tip: A full row clear will cause all tiles to fall down until they hit another
    settled tile, obstacle, or the bottom row of the board.'
  - 'Tip: Keep an eye on your unit reserve. If it reaches 0, the run is over.'
  - 'Tip: Level modifiers stack with your run buffs and debuffs.'
  - 'Tip: Level modifiers only last for a single level.'
  - 'Tip: Each monster unit has it''s own special passive and they will become stronger
    when the unit reaches level 10, 20 and 30.'
  - 'Tip: Don''t know what a special block or floor effect does? Check the help menu
    for a more tailed breakdown! '
  - 'Tip: Struggling to survive? Check out the shop to purchase permanent stackable
    buffs to make your run easier. '
  - 'Tip: Don''t like the music? Open the settings menu and try out a different genre.
    Still don''t like it? Turn the Music volume in settings down to 0!'
  - 'Tip: The lighting special block will destroy all monster units in a column as
    well as any spike traps.'
  - 'Tip: The bomb special block will force unsupported units in the effected columns
    to fall.'
  - 'Tip: Unlock harder difficulties by beating all 14 levels in a single run.'
  - 'Tip: Destroying stone obstacles has a chance to drop a buff to make your run
    a bit easier.'
  - 'Tip: The final level is endless, but will grow more difficult to survive over
    time.'
  - 'Tip: There is an increased chance to find gold after clearing a row in the endless
    level based on your star difficulty (+5% chance per star).'
