    watchedPanelShouldBeVisible: 0
  - stepId: Monster_Select_1
    body: Now we will set up our monster squadron that will go into battle with our
      Commander. Press the [Select Monsters] button in the bottom right.
    pauseGameplay: 0
    allowSkip: 0
    autoAdvanceOnComplete: 1
    allowSoftDropDuringStep: 0
