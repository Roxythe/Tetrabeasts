    watchedPanel: {fileID: 35795727}
    enforceWatchedPanelState: 0
    watchedPanelShouldBeVisible: 1
  - stepId: Commander_Select_2
    body: We only have one Commander that we can use at the moment, but with enough
      gold we can hire more. Each commander has their own special ability. The details
      of each ability can be seen in the Commander's preview on the right. (Press
      [F] to Continue)
    pauseGameplay: 0
    allowSkip: 0
    autoAdvanceOnComplete: 1
    allowSoftDropDuringStep: 0
