    watchedPanelShouldBeVisible: 1
  - stepId: Commander_Select_1
    body: Before going into battle, we will first have to select our commander. Press
      the [Select Commander] button in the bottom right to see who is available.
    pauseGameplay: 0
    allowSkip: 0
    autoAdvanceOnComplete: 1
    allowSoftDropDuringStep: 0
