    watchedButton: {fileID: 1890700155}
    watchedPanel: {fileID: 1480193591}
    enforceWatchedPanelState: 0
    watchedPanelShouldBeVisible: 1
  - stepId: Monster_Select_2
    body: As you can see we only have so many monsters to work with to create our
      squadron. A Squadron must have at least two monsters and can have a maximum
      of 4. (Press [F] to Continue)
    pauseGameplay: 0
    allowSkip: 0
    autoAdvanceOnComplete: 1
    allowSoftDropDuringStep: 0
    allowHardDropDuringStep: 0
    lockOtherButtonsDuringStep: 1
    popupAnchorPreset: 1
