    watchedPanel: {fileID: 35795727}
    enforceWatchedPanelState: 1
    watchedPanelShouldBeVisible: 1
  - stepId: Commander_Select_3
    body: Since our commander is already selected lets confirm the selection at the
      bottom by pressing the [Confirm] button and head back to the main lobby.
    pauseGameplay: 0
    allowSkip: 0
    autoAdvanceOnComplete: 1
    allowSoftDropDuringStep: 0
    allowHardDropDuringStep: 0
    lockOtherButtonsDuringStep: 1
    popupAnchorPreset: 1
