  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SpecialBlockTutorialController
  gameController: {fileID: 2092384764}
  triggeredTutorialPopups: {fileID: 2092384772}
  popupAnchorPreset: 2
  popupAnchoredPosition: {x: 0, y: 0}
  popupAlpha: 1
  highlightPadding: {x: 12, y: 12}
  hardDropGraceSeconds: 0.25
  tutorials:
  - specialType: 1
    tutorialId: tutorial_special_block_death6
    body: You found a Death special block. Drop it in a column to destroy all units
      matching the first monster below its landing point. (Press [F] to Continue)
  - specialType: 2
    tutorialId: tutorial_special_block_bomb6
    body: You found a Bomb special block. Drop it to blast a 3x3 area and damage
      nearby obstacles. Stone obstacles will be destroyed completley regardless of
      their current condition. (Press [F] to Continue)
  - specialType: 3
    tutorialId: tutorial_special_block_bolt6
    body: You found a Bolt special block. Drop it to strike an entire column forcing
      all units in that row to retreat from the board and destroying any spike traps
      in that column. (Press [F] to Continue)
  - specialType: 4
    tutorialId: tutorial_special_block_earthquake6
    body: You found an Earthquake special block. Shake loose units and obstacles
      dropping them down until they hit the bottom of the board or an occupied cell.
      Drop it anywhere, it makes no difference. (Press [F] to Continue)
  - specialType: 5
    tutorialId: tutorial_special_block_slow_gravity6
    body: You found a Slow Gravity special block. Drop it to slow falling pieces
      for a short time. Where it drops makes no difference. (Press [F] to Continue)
